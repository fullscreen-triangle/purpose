# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and stays on your machine.

# Anthropic API key. Get one at https://console.anthropic.com/.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the models used for triage and synthesis.
# Defaults: claude-sonnet-4-6 for triage, claude-opus-4-7 for synthesis.
# ANTHROPIC_TRIAGE_MODEL=claude-sonnet-4-6
# ANTHROPIC_SYNTHESIS_MODEL=claude-opus-4-7
