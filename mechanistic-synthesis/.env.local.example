# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and stays on your machine.

# =========================
# HuggingFace (recommended)
# =========================
# Get a Read token at https://huggingface.co/settings/tokens


# Optional: override the default models. Defaults are ungated 7B chat
# models routed through https://router.huggingface.co/v1/chat/completions.
# Gated models (Llama, Gemma) require you to accept their license on the
# model's HF page BEFORE the token can use them.
#
# Triage is a small / fast model that emits JSON.
# Synthesis (single-call fallback) is a larger model that writes the paper.
# HUGGINGFACE_TRIAGE_MODEL=Qwen/Qwen2.5-7B-Instruct
# HUGGINGFACE_SYNTHESIS_MODEL=Qwen/Qwen2.5-72B-Instruct

# Alternative model suggestions (any one of these can be substituted):
# Triage / federation members (small):
#   Qwen/Qwen2.5-7B-Instruct
#   microsoft/Phi-3.5-mini-instruct
#   HuggingFaceH4/zephyr-7b-beta
# Synthesis / integration (larger):
#   Qwen/Qwen2.5-72B-Instruct
#   mistralai/Mixtral-8x7B-Instruct-v0.1     (requires license acceptance)
#   meta-llama/Llama-3.3-70B-Instruct        (requires license acceptance)

# Optional: point at a custom inference endpoint (dedicated, partner,
# self-hosted, or a specific provider via the router). Default is the
# public unified router.
# HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1/chat/completions

# =========================
# Anthropic (fallback)
# =========================
# Used only if HUGGINGFACE_API_KEY is not set, or if LLM_PROVIDER=anthropic is forced.
# Get a key at https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_TRIAGE_MODEL=claude-sonnet-4-6
# ANTHROPIC_SYNTHESIS_MODEL=claude-opus-4-7

# =========================
# Forced provider selection
# =========================
# If you have both keys set and want to pin one provider, uncomment:
# LLM_PROVIDER=huggingface
# LLM_PROVIDER=anthropic

# =========================
# Federation pipeline (FKAC)
# =========================
# Enable/disable the parallel-drafting + integration pipeline. When
# disabled, synthesis falls back to a single model call (the
# INTEGRATION_MODEL below).
# FEDERATION_ENABLED=true

# Comma-separated HF model ids used as parallel drafters. The default
# federation is three ungated, broadly-available 7B chat models.
# FEDERATION_MODELS=Qwen/Qwen2.5-7B-Instruct,microsoft/Phi-3.5-mini-instruct,HuggingFaceH4/zephyr-7b-beta

# HF model id used for the integration step (consumes the drafts and
# emits the final synthesis).
# INTEGRATION_MODEL=Qwen/Qwen2.5-72B-Instruct
