# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and stays on your machine.

# =========================
# HuggingFace (recommended)
# =========================
# Get a Read token at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=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

# Optional: override the default models for each stage.
# Triage is a small / fast model that emits JSON.
# Synthesis is a larger model that writes the paper.
# Any model exposed on the HF Inference API works; gated models require
# you to have accepted their license on the model's HF page.
# HUGGINGFACE_TRIAGE_MODEL=meta-llama/Llama-3.1-8B-Instruct
# HUGGINGFACE_SYNTHESIS_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Optional: alternative model suggestions
# HUGGINGFACE_TRIAGE_MODEL=Qwen/Qwen2.5-7B-Instruct
# HUGGINGFACE_TRIAGE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# HUGGINGFACE_SYNTHESIS_MODEL=Qwen/Qwen2.5-72B-Instruct
# HUGGINGFACE_SYNTHESIS_MODEL=mistralai/Mixtral-8x7B-Instruct-v0.1

# Optional: point at a custom inference endpoint (dedicated, partner, or self-hosted).
# Default is the public serverless endpoint.
# HUGGINGFACE_BASE_URL=https://api-inference.huggingface.co/models

# =========================
# Anthropic (fallback)
# =========================
# Used only if HUGGINGFACE_API_KEY is not set, or if LLM_PROVIDER=anthropic is forced.
# Get a key at https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_TRIAGE_MODEL=claude-sonnet-4-6
# ANTHROPIC_SYNTHESIS_MODEL=claude-opus-4-7

# =========================
# Forced provider selection
# =========================
# If you have both keys set and want to pin one provider, uncomment:
# LLM_PROVIDER=huggingface
# LLM_PROVIDER=anthropic

# =========================
# Federation pipeline (FKAC)
# =========================
# Enable/disable the parallel-drafting + integration pipeline. When
# disabled, synthesis falls back to a single model call (the
# INTEGRATION_MODEL below).
# FEDERATION_ENABLED=true

# Comma-separated HF model ids used as parallel drafters. The default
# federation is three diverse open-weight 7-8B chat models.
# FEDERATION_MODELS=meta-llama/Llama-3.1-8B-Instruct,Qwen/Qwen2.5-7B-Instruct,mistralai/Mistral-7B-Instruct-v0.3

# HF model id used for the integration step (consumes the drafts and
# emits the final synthesis).
# INTEGRATION_MODEL=meta-llama/Llama-3.3-70B-Instruct
